# ==============================================================================
# DEVICE TRACKER — ENVIRONMENT CONFIGURATION
# ==============================================================================
#
# Copy this file before starting the application:
#
#   Linux / macOS:
#   cp .env.example .env
#
#   Windows PowerShell:
#   Copy-Item .env.example .env
#
# IMPORTANT SECURITY RULES:
# - Never commit the real .env file.
# - Never store production credentials in this example file.
# - Use HTTPS URLs in production.
# - Generate unique initial credentials and AUTH_IDENTITY_SECRET per deployment.
# - Disable local packet capture in Railway, cloud environments and public VPS
#   deployments unless the server was explicitly designed and authorized for it.
# - Do not add trailing slashes to URL values.
#
# The active values below are intended for LOCAL DEVELOPMENT.
#
# ==============================================================================


# ==============================================================================
# APPLICATION ENVIRONMENT
# ==============================================================================

# Supported values:
# - development: local development with detailed diagnostics
# - test: automated tests
# - production: hardened production behavior
NODE_ENV=development


# ==============================================================================
# DEPLOYMENT MODE
# ==============================================================================

# Supported application deployment profiles:
#
# local-full:
#   Runs the complete local application and allows authorized packet capture
#   when LOCAL_CAPTURE_ENABLED=true.
#
# railway-dashboard:
#   Runs the dashboard, API, statistics and database features without attempting
#   to capture packets from the Railway host network.
#
# Recommended local value:
DEPLOYMENT_MODE=local-full

# Enables or disables capture functionality on the current machine.
#
# Security recommendation:
# - Local authorized workstation: true
# - Railway / cloud dashboard: false
# - Public VPS: false unless capture is explicitly authorized and configured
#
# This value should never override operating-system permissions or legal
# authorization requirements.
LOCAL_CAPTURE_ENABLED=true

# Contact observation is passive by default: it records real WhatsApp events
# without creating probe messages. Active delete/reaction probes remain an
# opt-in experimental diagnostic and are never recommended for normal clients.
ENABLE_EXPERIMENTAL_PROBES=false

# These limits apply only when experimental probes are explicitly enabled.
# Backoff prevents overlapping requests and uncontrolled database growth.
PROBE_INTERVAL_MS=30000
PROBE_TIMEOUT_MS=10000
PROBE_MAX_BACKOFF_MS=300000


# ==============================================================================
# SERVER PORTS
# ==============================================================================

# Port used by the backend REST API and Socket.IO server.
#
# Railway normally injects its own PORT environment variable. The backend code
# should prioritize process.env.PORT when available and use BACKEND_PORT as the
# local fallback.
BACKEND_PORT=4000

# Local development port used by the frontend application.
#
# In managed frontend deployments, the hosting platform may assign the public
# port automatically.
CLIENT_PORT=4001


# ==============================================================================
# APPLICATION URLS
# ==============================================================================

# Backend URL consumed by the frontend.
#
# Local:
#   http://127.0.0.1:4000
#
# Production:
#   https://api.example.com
#
# Do not include a trailing slash.
BACKEND_URL=http://127.0.0.1:4000

# Publicly accessible backend base URL.
#
# This URL is used to generate Authorized Check-In links, public metadata and
# Open Graph preview URLs.
#
# Localhost and 127.0.0.1 work only from the current computer. Production
# deployments must use the public HTTPS domain assigned by Railway, a reverse
# proxy or the project's custom domain.
#
# Local:
#   http://127.0.0.1:4000
#
# Railway example:
#   https://your-service.up.railway.app
#
# Custom domain example:
#   https://api.example.com
#
# Do not include a trailing slash.
PUBLIC_BASE_URL=http://127.0.0.1:4000


# ==============================================================================
# CROSS-ORIGIN RESOURCE SHARING — CORS
# ==============================================================================

# Comma-separated list of frontend origins allowed to communicate with the
# backend.
#
# Rules:
# - Include the protocol: http:// or https://
# - Include the port when it is not the default port
# - Do not include paths such as /dashboard
# - Do not add trailing slashes
# - Do not use "*" when requests include credentials or authentication
# - In production, include only domains controlled by the project
#
# Local development:
ALLOWED_ORIGINS=http://127.0.0.1:4001,http://localhost:4001

# Multiple production frontends example:
# ALLOWED_ORIGINS=https://dashboard.example.com,https://admin.example.com


# ==============================================================================
# MONGODB
# ==============================================================================

# MongoDB connection URI.
#
# Local MongoDB:
#   mongodb://127.0.0.1:27017
#
# MongoDB Atlas example:
#   mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
#
# Security requirements:
# - Never place a real username or password in .env.example.
# - Percent-encode special characters contained in usernames or passwords.
# - Restrict database network access to trusted environments.
# - Use a dedicated database user with the minimum required permissions.
# - Rotate the password if it is ever exposed.
MONGODB_URI=mongodb://127.0.0.1:27017

# Application database name.
#
# Use a different database for each environment to avoid mixing test,
# development and production data.
#
# Examples:
# - device-tracker-development
# - device-tracker-test
# - device-tracker-production
MONGODB_DB=device-tracker


# ==============================================================================
# REDIS — OPERATOR SESSIONS, SHARED RATE LIMITS AND COUNTERS
# ==============================================================================

# Redis is required in every runtime mode because operator sessions and login
# limits use it. The backend fails before listening when it is absent/unavailable.
#
# Native local/VPS example:
#   redis://127.0.0.1:6379
#
# Managed Redis with TLS example:
#   rediss://USERNAME:PASSWORD@HOST:PORT
#
# Do not expose port 6379 publicly and never commit credentials.
REDIS_URL=

# Kept explicit for deployment manifests and health output. Redis is required
# by authentication regardless of this compatibility flag.
REDIS_REQUIRED=true

# Namespace for this deployment's Redis keys. Use a different prefix per
# environment when several deployments share one Redis instance.
REDIS_KEY_PREFIX=wp-monitor

# Connection and command budgets in milliseconds.
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1500
REDIS_PING_INTERVAL_MS=30000


# ==============================================================================
# SINGLE-OPERATOR DASHBOARD AUTHENTICATION
# ==============================================================================

# The first successful startup creates exactly one operator in MongoDB. These
# bootstrap credentials are read only when that operator does not exist. After
# creation, changing the username/password in the dashboard updates MongoDB and
# these values no longer authenticate or reset the account.
#
# Usernames allow 3-64 ASCII letters, numbers, dots, underscores and hyphens.
# Passwords require 15-128 characters and are stored only as salted scrypt
# hashes. Never commit or print the real password.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
#
# Server-side HMAC secret for opaque rate-limit and session identities. It must
# contain at least 32 characters in production and never enters browser code.
# Generate it with Node.js:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
AUTH_IDENTITY_SECRET=

# Absolute dashboard session lifetime in seconds: 5 minutes to 7 days.
AUTH_SESSION_TTL_SECONDS=28800

# Limits memory-hard password verification concurrency per backend process.
# Keep 1 on a single-operator VPS unless capacity testing proves otherwise.
AUTH_PASSWORD_VERIFY_CONCURRENCY=1

# Persistent Redis-backed login limits. All identities are HMACed before being
# used as Redis keys. If Redis is unavailable, login fails closed.
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_RATE_MAX_PER_IP=50
AUTH_LOGIN_RATE_MAX_PER_USERNAME=50
AUTH_LOGIN_RATE_MAX_PER_USERNAME_IP=10

# Legacy local migration compatibility: if INITIAL_ADMIN_PASSWORD or
# AUTH_IDENTITY_SECRET are empty, an existing DASHBOARD_TOKEN can bootstrap the
# first operator and derive opaque identities. It is never accepted by the API.
DASHBOARD_TOKEN=


# ==============================================================================
# REVERSE PROXY AND CLIENT IP DETECTION
# ==============================================================================

# Express proxy trust configuration used when reading the actual client IP from
# headers such as X-Forwarded-For.
#
# Recommended values:
#
# Local development:
#   TRUST_PROXY=false
#
# Railway or a deployment behind one trusted reverse proxy:
#   TRUST_PROXY=1
#
# SECURITY WARNING:
# Do not enable unrestricted proxy trust on a server directly exposed to the
# internet. Incorrect proxy trust can allow clients to spoof their IP address
# and bypass IP-based controls.
TRUST_PROXY=false


# ==============================================================================
# AUTHORIZED CHECK-IN RATE LIMITING
# ==============================================================================

# Time window for public Authorized Check-In submission limits.
#
# Value is expressed in milliseconds.
#
# 600000 milliseconds = 10 minutes
CHECKIN_SUBMIT_RATE_WINDOW_MS=600000

# Maximum submissions allowed from one IP address during the configured window.
CHECKIN_SUBMIT_RATE_MAX_PER_IP=60

# Maximum submissions allowed for the same combination of authorization token
# and source IP during the configured window.
CHECKIN_SUBMIT_RATE_MAX_PER_TOKEN_IP=8

# With REDIS_URL configured, both counters are incremented atomically in Redis,
# survive backend deployments, and are shared by every replica using the same
# REDIS_KEY_PREFIX. If configured Redis is unavailable, public submissions fail
# closed with HTTP 503 instead of bypassing the limits.


# ==============================================================================
# API DOCUMENTATION
# ==============================================================================

# Enables Swagger/OpenAPI documentation.
#
# Swagger should be available only when:
# - ENABLE_SWAGGER=true
# - NODE_ENV is not production
#
# Keep this disabled on publicly accessible production deployments unless the
# documentation is separately authenticated and intentionally exposed.
ENABLE_SWAGGER=false


# ==============================================================================
# IP ADDRESS ENRICHMENT
# ==============================================================================

# Enables external IP metadata enrichment for authorized call-analysis
# candidates.
#
# Depending on provider availability, enrichment may include:
# - Country
# - Region
# - City
# - Approximate coordinates
# - Internet service provider
# - Organization
# - Autonomous System Number
# - Mobile, proxy or hosting indicators
#
# Privacy notice:
# Enabling this feature may send IP addresses to external providers. Confirm
# that its use is covered by the project's privacy policy, authorization model
# and applicable data-protection requirements.
ENABLE_IP_ENRICHMENT=true

# Primary enrichment provider.
#
# Supported project value:
# - db-ip
IP_ENRICHMENT_PRIMARY_PROVIDER=db-ip

# DB-IP access key.
#
# Use "free" for the project's supported free lookup mode.
# For a paid account, store the real key only in the private .env or deployment
# secret manager.
DB_IP_API_KEY=free

# Time-to-live for cached enrichment responses, expressed in seconds.
#
# 604800 seconds = 7 days
IP_ENRICHMENT_CACHE_TTL_SEC=604800

# Maximum time allowed for an external enrichment request, in milliseconds.
#
# Requests exceeding this value should fail safely without blocking the main
# application workflow.
IP_ENRICHMENT_TIMEOUT_MS=3500


# ==============================================================================
# OPTIONAL AUTOMATIC CAPTURE METADATA
# ==============================================================================

# These values are used only when automatic capture is triggered by authorized
# backend events.
#
# Manual capture initiated from the dashboard UI should provide these values for
# each individual capture operation.
#
# Do not use generic or misleading values in production. Each case should remain
# attributable to an actual authorization, operator and operational reason.

# Internal authorized case or investigation identifier.
# DEFAULT_CASE_ID=

# Name, username or identifier of the responsible authorized operator.
# DEFAULT_OPERATOR_NAME=

# Human-readable authorization basis, ticket reference or operational note.
#
# Wrap the value in quotes when it contains spaces:
# DEFAULT_AUTHORIZATION_NOTE="Authorized security validation ticket SEC-0001"


# ==============================================================================
# LOCAL DEVELOPMENT REFERENCE
# ==============================================================================
#
# NODE_ENV=development
# DEPLOYMENT_MODE=local-full
# LOCAL_CAPTURE_ENABLED=true
#
# BACKEND_PORT=4000
# CLIENT_PORT=4001
#
# BACKEND_URL=http://127.0.0.1:4000
# PUBLIC_BASE_URL=http://127.0.0.1:4000
# ALLOWED_ORIGINS=http://127.0.0.1:4001,http://localhost:4001
#
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=device-tracker
#
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_REQUIRED=true
# REDIS_KEY_PREFIX=wp-monitor-development
#
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=
# AUTH_IDENTITY_SECRET=
# AUTH_SESSION_TTL_SECONDS=28800
# AUTH_PASSWORD_VERIFY_CONCURRENCY=1
# TRUST_PROXY=false
# ENABLE_SWAGGER=false


# ==============================================================================
# RAILWAY / PRODUCTION REFERENCE
# ==============================================================================
#
# Do not uncomment this entire block blindly. Configure each value through the
# Railway Variables panel or the deployment platform's secret manager.
#
# NODE_ENV=production
# DEPLOYMENT_MODE=railway-dashboard
# LOCAL_CAPTURE_ENABLED=false
#
# BACKEND_URL=https://api.example.com
# PUBLIC_BASE_URL=https://api.example.com
# ALLOWED_ORIGINS=https://dashboard.example.com
#
# MONGODB_URI=mongodb+srv://REDACTED
# MONGODB_DB=device-tracker-production
#
# REDIS_URL=rediss://USERNAME:PASSWORD@REDIS_HOST:PORT
# REDIS_REQUIRED=true
# REDIS_KEY_PREFIX=wp-monitor-production
#
# INITIAL_ADMIN_USERNAME=CHOOSE_A_NON_DEFAULT_USERNAME
# INITIAL_ADMIN_PASSWORD=STORE_IN_A_PASSWORD_MANAGER
# AUTH_IDENTITY_SECRET=GENERATE_A_UNIQUE_64_CHARACTER_SECRET
# AUTH_SESSION_TTL_SECONDS=28800
# AUTH_PASSWORD_VERIFY_CONCURRENCY=1
# TRUST_PROXY=1
#
# CHECKIN_SUBMIT_RATE_WINDOW_MS=600000
# CHECKIN_SUBMIT_RATE_MAX_PER_IP=60
# CHECKIN_SUBMIT_RATE_MAX_PER_TOKEN_IP=8
#
# ENABLE_SWAGGER=false
#
# ENABLE_IP_ENRICHMENT=true
# IP_ENRICHMENT_PRIMARY_PROVIDER=db-ip
# DB_IP_API_KEY=free
# IP_ENRICHMENT_CACHE_TTL_SEC=604800
# IP_ENRICHMENT_TIMEOUT_MS=3500


# ==============================================================================
# END OF FILE
# ==============================================================================

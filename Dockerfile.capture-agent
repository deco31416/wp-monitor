ARG NODE_IMAGE=node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
FROM ${NODE_IMAGE} AS build

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ libpcap-dev \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY client/package.json ./client/package.json
COPY patches ./patches
COPY scripts/verify-node-version.mjs ./scripts/verify-node-version.mjs
COPY tsconfig.json ./

RUN pnpm install --frozen-lockfile --filter @deco31416/wp-monitor...

COPY src ./src
RUN pnpm run build

FROM ${NODE_IMAGE} AS runtime

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV CAPTURE_AGENT_PORT=4100

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY LICENSE THIRD_PARTY_NOTICES.md ./
COPY --chmod=755 scripts/capture-agent/entrypoint.sh /usr/local/bin/wp-capture-agent-entrypoint

EXPOSE 4100

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/usr/bin/setpriv", "--reuid=1000", "--regid=1000", "--clear-groups", "--bounding-set=-all", "--nnp", "/usr/local/bin/node", "-e", "const port=process.env.CAPTURE_AGENT_PORT||'4100';fetch('http://127.0.0.1:'+port+'/v1/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

ENTRYPOINT ["/usr/local/bin/wp-capture-agent-entrypoint"]
